remarks file toppar/dna-rna.link
remarks macro to define standard nucleic acid links and termini
remarks this file has both 3' and 5' terminii without phosphate groups
remarks

set message ? end eval ($old_message=$result) set echo ? end eval ($old_echo=$result)
set message=off echo=off end

checkversion 1.3

link  nuc  head - DA  tail + DA end
link  nuc  head - DA  tail + DC end
link  nuc  head - DA  tail + DG end
link  nuc  head - DA  tail + DT end
link  nuc  head - DA  tail + DJ end

link  nuc  head - DC  tail + DA end
link  nuc  head - DC  tail + DC end
link  nuc  head - DC  tail + DG end
link  nuc  head - DC  tail + DT end
link  nuc  head - DC  tail + DJ end

link  nuc  head - DG  tail + DA end
link  nuc  head - DG  tail + DC end
link  nuc  head - DG  tail + DG end
link  nuc  head - DG  tail + DT end
link  nuc  head - DG  tail + DJ end

link  nuc  head - DT  tail + DA end
link  nuc  head - DT  tail + DC end
link  nuc  head - DT  tail + DG end
link  nuc  head - DT  tail + DT end
link  nuc  head - DT  tail + DJ end

link  nuc  head - DJ  tail + DA end
link  nuc  head - DJ  tail + DC end
link  nuc  head - DJ  tail + DG end
link  nuc  head - DJ  tail + DT end
link  nuc  head - DJ  tail + DJ end


link  nuc  head - A  tail + A end
link  nuc  head - A  tail + C end
link  nuc  head - A  tail + G end
link  nuc  head - A  tail + U end

link  nuc  head - C  tail + A end
link  nuc  head - C  tail + C end
link  nuc  head - C  tail + G end
link  nuc  head - C  tail + U end

link  nuc  head - G  tail + A end
link  nuc  head - G  tail + C end
link  nuc  head - G  tail + G end
link  nuc  head - G  tail + U end

link  nuc  head - U  tail + A end
link  nuc  head - U  tail + C end
link  nuc  head - U  tail + G end
link  nuc  head - U  tail + U end

!6MZ
link  nuc  head - A    tail + 6MZ end
link  nuc  head - C    tail + 6MZ end
link  nuc  head - G    tail + 6MZ end
link  nuc  head - U    tail + 6MZ end

link  nuc  head - 6MZ  tail + A end
link  nuc  head - 6MZ  tail + C end
link  nuc  head - 6MZ  tail + G end
link  nuc  head - 6MZ  tail + U end

link  nuc  head - 6MZ  tail + 6MZ end

first 5ter tail + 6MZ end

last  3ter head - 6MZ end

!1MA
link  nuc  head - A    tail + 1MA end
link  nuc  head - C    tail + 1MA end
link  nuc  head - G    tail + 1MA end
link  nuc  head - U    tail + 1MA end

link  nuc  head - 1MA  tail + A end
link  nuc  head - 1MA  tail + C end
link  nuc  head - 1MA  tail + G end
link  nuc  head - 1MA  tail + U end

link  nuc  head - 1MA  tail + 1MA end

first 5ter tail + 1MA end

last  3ter head - 1MA end

!5MC
link  nuc  head - A    tail + 5MC end
link  nuc  head - C    tail + 5MC end
link  nuc  head - G    tail + 5MC end
link  nuc  head - U    tail + 5MC end

link  nuc  head - 5MC  tail + A end
link  nuc  head - 5MC  tail + C end
link  nuc  head - 5MC  tail + G end
link  nuc  head - 5MC  tail + U end

link  nuc  head - 5MC  tail + 5MC end

first 5ter tail + 5MC end

last  3ter head - 5MC end

!A2M
link  nuc  head - A    tail + A2M end
link  nuc  head - C    tail + A2M end
link  nuc  head - G    tail + A2M end
link  nuc  head - U    tail + A2M end

link  nuc  head - A2M  tail + A end
link  nuc  head - A2M  tail + C end
link  nuc  head - A2M  tail + G end
link  nuc  head - A2M  tail + U end

link  nuc  head - A2M  tail + A2M end

first 5ter tail + A2M end

last  3ter head - A2M end

!PSU
link  nuc  head - A    tail + PSU end
link  nuc  head - C    tail + PSU end
link  nuc  head - G    tail + PSU end
link  nuc  head - U    tail + PSU end

link  nuc  head - PSU  tail + A end
link  nuc  head - PSU  tail + C end
link  nuc  head - PSU  tail + G end
link  nuc  head - PSU  tail + U end

link  nuc  head - PSU  tail + PSU end

first 5ter tail + PSU end

last  3ter head - PSU end


first 5ter tail + a end
first 5ter tail + c end
first 5ter tail + g end
first 5ter tail + u end

first 5ter tail + da end
first 5ter tail + dc end
first 5ter tail + dg end
first 5ter tail + dt end
first 5ter tail + dj end


last  3ter head - a end
last  3ter head - c end
last  3ter head - g end
last  3ter head - u end

last  3ter head - da end
last  3ter head - dc end
last  3ter head - dg end
last  3ter head - dt end
last  3ter head - dj end


set message=$old_message echo=$old_echo end
