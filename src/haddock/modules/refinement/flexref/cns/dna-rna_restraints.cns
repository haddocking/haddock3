! dna-rna_restraints.def
!    Define backbone dihedral angles, hbonds and planarity restraints
!    for nucleic acids
!
! ***********************************************************************
! * Copyright 2003-2022 Alexandre Bonvin, Utrecht University.           *
! * This code is part of the HADDOCK software and governed by its       *
! * license. Please see the LICENSE file that should have been included *
! * as part of this package.                                            *
! ***********************************************************************
!
{+ file: dna-rna_restraints.def +}
{+ description: Creates restraints to maintain conformation of DNA/RNA +}
{+ Additions and changes were made to allow for flexibility during docking +}
{+ comment:This file is to be read by refinement files that modify atom coordinates +}
{+ authors: Axel T. Brunger, and Paul D. Adams +}
{+ modified by Alexandre Bonvin and Marc van Dijk for HADDOCK use +}

{============================================== base planarity =============================================}

{* Restrain base planarity. This selection must only include nucleotide residues *}
evaluate ($dna_bases_planar=true)

{=================================== sugar-pucker dihedral angle restraints ================================}

{* Pick the dihedral angles of the sugar pucker from the input structure
   and restrain them within the given error range *}
evaluate ($dna_pick_pucdih=true)

{* dihedral C1'-C2'-C3'-C4' error range *}
evaluate ($error_nu2=0.0)
{* dihedral C5'-C4'-C3'-C2' error range *}
evaluate ($error_nu3=0.0)
{* dihedral C1'-O4'-C4'-C5' error range *}
evaluate ($error_nu4=0.0)

{================================ phosphate backbone dihedral angle restraints =============================}

{* Pick the dihedral angles of the phosphate backbone from the input structure and
   restrain them within the given error range *}
evaluate ($dna_pick_bacdih=true)

{* Error range for phosphate backbone dihedrals *}
{* alpha dihedral O3'-P-O5'-C5' error range *}
evaluate ($error_alpha=10.0)
{* beta dihedral P-O5'-C5'-C4' error range *}
evaluate ($error_beta=40.0)
{* gamma dihedral O5'-C5'-C4'-C3' error range *}
evaluate ($error_gamma=20.0)
{* delta dihedral C5'-C4'-C3'-O3' error range *}
evaluate ($error_delta=50.0)
{* epsilon dihedral C4'-C3'-O3'-P error range *}
evaluate ($error_eps=10.0)
{* zeta dihedral C3'-O3'-P-O5' error range *}
evaluate ($error_zeta=50.0)


{=========================================== Watson-Crick base pairs =======================================}

{* automatically pick Watson-Crick restraint values from structure *}
evaluate ($dna_pick_wc=true)

{* error range used for dna_pick_wc defined Watson-Crick restraints *}
evaluate ($wc_low=0.05)
evaluate ($wc_up=0.05)

{* Donor-acceptor cutoff used to detect a base pair in an all-atom model:
   A N1...T/U N3 or C N3...G N1, plus A N6...T/U O4 or C N4...G O6 and
   C O2...G N2. Watson-Crick pairs have all of these at 2.4-3.2 A. *}
evaluate ($hbcut=3.5)

{* A candidate base pair is accepted only with Watson-Crick geometry, judged
   by the distance between the atoms carrying the glycosidic bond: C1'-C1'
   in all-atom models, SC1-SC1 in CG models. Over 97 Watson-Crick pairs
   (B-DNA, A-RNA, tRNA, protein-DNA and drug-DNA complexes), C1'-C1' spans
   9.98-11.01 A against 8.08-8.72 A for Hoogsteen pairs. In CG models built
   by topocg, SC1-SC1 spans 7.63-9.03 A; it rejects the diagonal
   cross-strand neighbours of A-form helices and overlapping copies of a
   strand, while Hoogsteen pairs are rejected by the contact cutoff. *}
evaluate ($wc_c1_min=9.4)
evaluate ($wc_c1_max=11.6)
evaluate ($wc_sc1_min=7.55)
evaluate ($wc_sc1_max=9.5)


{=========================================== Coarse-Grained ===========================================================}
{* Is the DNA/RNA molecule CG?
   Leave at false to auto-detect: a CG nucleic acid is recognised by its
   BB1/BB2/BB3 backbone beads. Set to true to force CG treatment. *}
evaluate ($dna_cg=false)

{* Distance cutoff used to detect a base pair in a CG model.
   The all-atom code pairs bases on a donor-acceptor contact within $hbcut
   (3.5 A). In the CG model that contact becomes a bead-bead distance:
   A/DA SC3 - T/DT/U SC2, and C/DC SC2 - G/DG SC3. In CG models built by
   topocg that contact spans 3.28-5.12 A for Watson-Crick pairs, against
   5.59-6.04 A for Hoogsteen pairs, so 5.3 A is used. The two other
   base-base contacts of a pair must also fall within it. Candidates are
   filtered on geometry (see $wc_sc1_min/$wc_sc1_max above) and the nearest
   remaining one is taken as the partner. *}
evaluate ($hbcut_cg=5.3)

{=========================================================================================================}
{                        things below this line do not normally need to be changed                        }
{=========================================================================================================}


{- detect a coarse-grained nucleic acid -}
! CG nucleotides carry BB1/BB2/BB3 backbone beads and SC1..SC4 base beads
! instead of the all-atom phosphate/sugar/base atoms. All nucleic acids in a
! run share one representation, so a single global flag is enough.
if ($dna_cg=false) then
    show sum(1) ( name BB1 and
                  (resn DA or resn A or resn DG or resn G or resn DT or
                   resn T or resn DC or resn C or resn U) )
    if ( $result > 0 ) then
        evaluate ($dna_cg=true)
        display DNA/RNA: coarse-grained model detected, using CG restraints
    end if
end if

{- find max and min residue numbers -}
evaluate ($min_resid = 99999)
evaluate ($max_resid = -99999)
show sum(1) ( (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) and tag )
if ( $result > 0 ) then
    for $id in id  ( (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) and tag ) loop resid
        show (resid) ( id $id )
        evaluate ($resid=decode($result))
        evaluate ($min_resid = max($min_resid,$resid))
        evaluate ($max_resid = max($max_resid,$resid))
    end loop resid
end if

{- the planarity restraints single bases -}
if ($dna_bases_planar=true) then
    for $id in id ( tag and (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) ) loop plan
        show (segid) (id $id)
        evaluate ($segid=$result)
        show (resid) (id $id)
        evaluate ($resid=decode($result))
        evaluate ($plweight = 20)

        if ($dna_cg=true) then
            ! The CG base is SC1..SC4. Only purines (A, DA, G, DG) have four
            ! base beads; pyrimidines have three, and CNS aborts on a plane
            ! group of fewer than four atoms. Test for the fourth bead rather
            ! than listing residue names, so the check follows the mapping.
            show sum(1) ( segid $segid and resid $resid and name SC4 )
            if ( $result > 0 ) then
                restraints plane
                    group
                        selection=( segid $segid and resid $resid and
                                  (resn G or resn A or resn DG or resn DA) and
                                   name SC# )
                        weight=$plweight
                    end
                end
            end if
        else
            restraints plane
                group
                    selection=( segid $segid and resid $resid and
                              (resn T   or resn C   or resn G   or resn A   or resn U or
                               resn DT  or resn DC  or resn DG  or resn DA) and
                               not (name c#' or name h#' or name h#'' or name o#p or
                               name h7# or name o#' or name p or name h#t or name o#t))
                    weight=$plweight
                end
            end
        end if
    end loop plan
end if

{- Dihedral restraints for the sugar pucker -}

! Not available for CG models: the sugar ring (C1'-C2'-C3'-C4'-O4') is
! absorbed into the BB2/BB3 beads, so these dihedrals have no counterpart.
if ($dna_cg=true) then
    evaluate ($dna_pick_pucdih=false)
end if

if ($dna_pick_pucdih=true) then
    show sum(1) ( (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) and tag )
    if ( $result > 0 ) then
        for $id in id ( (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) and tag ) loop resid
            show (segid) (id $id)
            evaluate ($segid=$result)
            show (resid) ( id $id )
            evaluate ($resid=decode($result))
            pick dihedral
                ( segid $segid and resid $resid and name c1' )
                ( segid $segid and resid $resid and name c2' )
                ( segid $segid and resid $resid and name c3' )
                ( segid $segid and resid $resid and name c4' )
                geometry
            evaluatate ($dihedral_nu2=$result)
            pick dihedral
                ( segid $segid and resid $resid and name c5' )
                ( segid $segid and resid $resid and name c4' )
                ( segid $segid and resid $resid and name c3' )
                ( segid $segid and resid $resid and name c2' )
                geometry
            evaluatate ($dihedral_nu3=$result)
            pick dihedral
                ( segid $segid and resid $resid and name c1' )
                ( segid $segid and resid $resid and name o4' )
                ( segid $segid and resid $resid and name c4' )
                ( segid $segid and resid $resid and name c5' )
                geometry
            evaluatate ($dihedral_nu4=$result)
            restraints dihedral
                assign  ( segid $segid and resid $resid and name c1' )
                        ( segid $segid and resid $resid and name c2' )
                        ( segid $segid and resid $resid and name c3' )
                        ( segid $segid and resid $resid and name c4' )
                        20.0 $dihedral_nu2 $error_nu2 2
                assign  ( segid $segid and resid $resid and name c5' )
                        ( segid $segid and resid $resid and name c4' )
                        ( segid $segid and resid $resid and name c3' )
                        ( segid $segid and resid $resid and name c2' )
                        20.0 $dihedral_nu3 $error_nu3 2
                assign  ( segid $segid and resid $resid and name c1' )
                        ( segid $segid and resid $resid and name o4' )
                        ( segid $segid and resid $resid and name c4' )
                        ( segid $segid and resid $resid and name c5' )
                        20.0 $dihedral_nu4 $error_nu4 2
                scale=20.0
            end
        end loop resid
        flags include cdih end
    end if
end if

{- Dihedral restraints for the phosphate backbone -}

! Not available for CG models: alpha..zeta are defined over P, O5', C5', C4',
! C3' and O3', which are absorbed into the BB1/BB2/BB3 beads.
if ($dna_cg=true) then
    evaluate ($dna_pick_bacdih=false)
end if

if ($dna_pick_bacdih=true) then
    show sum(1) ( (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) and tag )
    if ( $result > 0 ) then
        evaluate ($resid=$min_resid)
        evaluate ($nres=$max_resid - $min_resid + 1)
        evaluate ($error_alpha=$error_alpha)
        evaluate ($error_beta=$error_beta)
        evaluate ($error_gamma=$error_gamma)
        evaluate ($error_zeta=$error_zeta)
        evaluate ($error_epsilon=$error_eps)
        evaluate ($error_delta=$error_delta)
        for $id in id ( (resn DA or resn A or resn DG or resn G or resn DT or resn T or resn DC or resn C or resn U) and tag ) loop resid
            show (segid) (id $id)
            evaluate ($segid=$result)
            show (resid) ( id $id )
            evaluate ($resid=decode($result))
            if ($resid > $min_resid) then
                evaluate ($rprec = $resid - 1)
                ! check if previous residue exists
                show sum(1) ( resid $rprec and tag )
                if ( $result > 0 ) then
                    pick dihedral
                        ( segid $segid and resid $rprec and name O3' )
                        ( segid $segid and resid $resid and name P )
                        ( segid $segid and resid $resid and name O5' )
                        ( segid $segid and resid $resid and name C5' )
                        geometry
                    evaluatate ($dihedral_alpha=$result)
                    pick dihedral
                        ( segid $segid and resid $resid and name P )
                        ( segid $segid and resid $resid and name O5' )
                        ( segid $segid and resid $resid and name C5' )
                        ( segid $segid and resid $resid and name C4' )
                        geometry
                    evaluatate ($dihedral_beta=$result)
                    restraint dihedral
                        ! alpha
                        assign ( segid $segid and resid $rprec and name O3' )
                               ( segid $segid and resid $resid and name P )
                               ( segid $segid and resid $resid and name O5' )
                               ( segid $segid and resid $resid and name C5' )
                               1.0 $dihedral_alpha $error_alpha 2
                        ! beta
                        assign ( segid $segid and resid $resid and name P )
                               ( segid $segid and resid $resid and name O5' )
                               ( segid $segid and resid $resid and name C5' )
                               ( segid $segid and resid $resid and name C4' )
                               1.0 $dihedral_beta $error_beta 2
                        scale 200.0
                    end
                end if
            end if

            pick dihedral
                ( segid $segid and resid $resid and name O5' )
                ( segid $segid and resid $resid and name C5' )
                ( segid $segid and resid $resid and name C4' )
                ( segid $segid and resid $resid and name C3' )
                geometry
            evaluatate ($dihedral_gamma=$result)
            pick dihedral
                ( segid $segid and resid $resid and name C5' )
                ( segid $segid and resid $resid and name C4' )
                ( segid $segid and resid $resid and name C3' )
                ( segid $segid and resid $resid and name O3' )
                geometry
            evaluatate ($dihedral_delta=$result)

            restraints dihedral
                ! gamma
                assign ( segid $segid and resid $resid and name O5' )
                       ( segid $segid and resid $resid and name C5' )
                       ( segid $segid and resid $resid and name C4' )
                       ( segid $segid and resid $resid and name C3' )
                       1.0 $dihedral_gamma $error_gamma 2
                ! delta
                assign ( segid $segid and resid $resid and name C5' )
                       ( segid $segid and resid $resid and name C4' )
                       ( segid $segid and resid $resid and name C3' )
                       ( segid $segid and resid $resid and name O3' )
                       1.0 $dihedral_delta $error_delta 2
                scale=200.0
            end

            if ($resid < $max_resid) then
                evaluate ($rfoll = $resid + 1)
                ! check if next residue exists
                show sum(1) ( resid $rfoll and segid $segid and tag )
                if ( $result > 0 ) then
                    pick dihedral
                        ( segid $segid and resid $resid and name C4' )
                        ( segid $segid and resid $resid and name C3' )
                        ( segid $segid and resid $resid and name O3' )
                        ( segid $segid and resid $rfoll and name P )
                        geometry
                    evaluatate ($dihedral_epsilon=$result)
                    pick dihedral
                        ( segid $segid and resid $resid and name C3' )
                        ( segid $segid and resid $resid and name O3' )
                        ( segid $segid and resid $rfoll and name P )
                        ( segid $segid and resid $rfoll and name O5' )
                        geometry
                    evaluatate ($dihedral_zeta=$result)
                    restraint dihedral
                        ! epsilon
                        assign ( segid $segid and resid $resid and name C4' )
                               ( segid $segid and resid $resid and name C3' )
                               ( segid $segid and resid $resid and name O3' )
                               ( segid $segid and resid $rfoll and name P )
                               1.0 $dihedral_epsilon $error_epsilon 2
                        ! zeta
                        assign ( segid $segid and resid $resid and name C3' )
                               ( segid $segid and resid $resid and name O3' )
                               ( segid $segid and resid $rfoll and name P )
                               ( segid $segid and resid $rfoll and name O5' )
                               1.0 $dihedral_zeta $error_zeta 2
                        scale 200.0
                    end
                end if
            end if
        end loop resid
        flags include cdih end
    end if
end if

{- Watson-Crick base pairing -}
! Every A/DA and C/DC base looks for its Watson-Crick partner among the
! T/DT/U and G/DG bases. A candidate must make the Watson-Crick contact
! (all-atom A N1...T N3 and C N3...G N1, CG A SC3...T SC2 and C SC2...G SC3)
! within the cutoff, have the two other base-base contacts within the cutoff
! as well, and have its anchor (C1'-C1' or SC1-SC1) distance inside the
! Watson-Crick window. If several candidates pass, the nearest is taken.
! Hoogsteen and reverse-Hoogsteen pairs fail these tests and stay
! unrestrained.
! All selections are segid-aware: resids repeat across chains, and in CG
! the SC# bead names are shared with protein side chains. Stacked neighbours
! are excluded on the current strand only, so a partner that happens to
! carry resid +/-1 on the opposite strand is still found.

if ($dna_pick_wc = true) then
    show sum(1) ( (resn DA or resn A or resn DC or resn C) and tag )
    if ( $result > 0 ) then
        noe
            class hres
            averaging hres cent
            potential hres square
            sqconstant hres 1.
            sqexponent hres 2
            scale hres 70.
        end

        ! The atoms used for detection differ between the two representations.
        ! Purine and pyrimidine choices are made per residue below.
        if ($dna_cg=true) then
            evaluate ($wc_cut=$hbcut_cg)
            evaluate ($wc_anc=SC1)
            evaluate ($wc_anc_min=$wc_sc1_min)
            evaluate ($wc_anc_max=$wc_sc1_max)
        else
            evaluate ($wc_cut=$hbcut)
            evaluate ($wc_anc=C1')
            evaluate ($wc_anc_min=$wc_c1_min)
            evaluate ($wc_anc_max=$wc_c1_max)
        end if

        for $id in id ( (resn DA or resn A or resn DC or resn C) and tag ) loop resid
            show (segid) (id $id)
            evaluate ($segid=$result)
            show (resid) ( id $id )
            evaluate ($resid=decode($result))
            evaluate ($presid=$resid-1)
            evaluate ($fresid=$resid+1)
            show ( resn ) (id $id)
            evaluate ($ares=$result)

            ! partner residue names, the Watson-Crick contact (w), and the two
            ! other contacts (x, y), each as (atom here, atom on partner).
            ! In CG the A N6...T O4 contact maps onto SC3...SC3, the only other
            ! contact for A-T, so x and y coincide.
            if ($ares = DA) then
                evaluate ($ares_name = ADE)
            elseif ($ares = A) then
                evaluate ($ares_name = ADE)
            else
                evaluate ($ares_name = CYT)
            end if
            if ($ares_name = ADE) then
                evaluate ($wc_pr1=DT)
                evaluate ($wc_pr2=T)
                evaluate ($wc_pr3=U)
                if ($dna_cg=true) then
                    evaluate ($wc_wa=SC3)
                    evaluate ($wc_wb=SC2)
                    evaluate ($wc_xa=SC3)
                    evaluate ($wc_xb=SC3)
                    evaluate ($wc_ya=SC3)
                    evaluate ($wc_yb=SC3)
                else
                    evaluate ($wc_wa=N1)
                    evaluate ($wc_wb=N3)
                    evaluate ($wc_xa=N6)
                    evaluate ($wc_xb=O4)
                    evaluate ($wc_ya=N6)
                    evaluate ($wc_yb=O4)
                end if
            else
                evaluate ($wc_pr1=DG)
                evaluate ($wc_pr2=G)
                evaluate ($wc_pr3=G)
                if ($dna_cg=true) then
                    evaluate ($wc_wa=SC2)
                    evaluate ($wc_wb=SC3)
                    evaluate ($wc_xa=SC3)
                    evaluate ($wc_xb=SC3)
                    evaluate ($wc_ya=SC2)
                    evaluate ($wc_yb=SC2)
                else
                    evaluate ($wc_wa=N3)
                    evaluate ($wc_wb=N1)
                    evaluate ($wc_xa=N4)
                    evaluate ($wc_xb=O6)
                    evaluate ($wc_ya=O2)
                    evaluate ($wc_yb=N2)
                end if
            end if

            evaluate ($dmin=999.0)
            for $jd in id ( ((resn $wc_pr1 or resn $wc_pr2 or resn $wc_pr3) and
                             not (segid $segid and (resid $presid or resid $fresid)) and name $wc_wb)
                            and (segid $segid and resid $resid and name $wc_wa) around $wc_cut ) loop wccand
                show (segid) (id $jd)
                evaluate ($qsegid=$result)
                show (resid) (id $jd)
                evaluate ($qresid=$result)
                pick bond (id $jd) (segid $segid and resid $resid and name $wc_wa) geometry
                evaluate ($dw=$result)
                pick bond (segid $segid and resid $resid and name $wc_anc)
                          (segid $qsegid and resid $qresid and name $wc_anc) geometry
                evaluate ($danc=$result)
                pick bond (segid $segid and resid $resid and name $wc_xa)
                          (segid $qsegid and resid $qresid and name $wc_xb) geometry
                evaluate ($dx=$result)
                pick bond (segid $segid and resid $resid and name $wc_ya)
                          (segid $qsegid and resid $qresid and name $wc_yb) geometry
                evaluate ($dy=$result)
                evaluate ($wc_ok=false)
                if ($danc >= $wc_anc_min) then
                    if ($danc <= $wc_anc_max) then
                        if ($dx <= $wc_cut) then
                            if ($dy <= $wc_cut) then
                                evaluate ($wc_ok=true)
                            end if
                        end if
                    end if
                end if
                if ($wc_ok = true) then
                    if ($dw < $dmin) then
                        evaluate ($dmin=$dw)
                        evaluate ($rpair=$qresid)
                        evaluate ($psegid=$qsegid)
                    end if
                end if
            end loop wccand

            if ($dmin < 999.0) then
              if ($ares_name = ADE) then
                if ($dna_cg=true) then
                    ! A N6...T O4 maps onto SC3...SC3, A N1...T N3 onto SC3...SC2.
                    ! The N1...O4 and N1...O2 pairs of the all-atom code collapse
                    ! onto those same two bead pairs and are therefore dropped.
                    pick bond
                        (segid $segid and resid $resid and name SC3)
                        (segid $psegid and resid $rpair and name SC3)
                        geometry
                    evaluate ($sc3sc3=$result)
                    pick bond
                        (segid $segid and resid $resid and name SC3)
                        (segid $psegid and resid $rpair and name SC2)
                        geometry
                    evaluate ($sc3sc2=$result)
                    noe
                        assign (segid $segid and resid $resid and name SC3)
                               (segid $psegid and resid $rpair and name SC3)
                               $sc3sc3 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name SC3)
                               (segid $psegid and resid $rpair and name SC2)
                               $sc3sc2 $wc_low $wc_up
                    end
                else
                    pick bond
                        (segid $segid and resid $resid and name N6)
                        (segid $psegid and resid $rpair and name O4)
                        geometry
                    evaluate ($n6o4=$result)
                    pick bond
                        (segid $segid and resid $resid and name N1)
                        (segid $psegid and resid $rpair and name N3)
                        geometry
                    evaluate ($n1n3=$result)
                    pick bond
                        (segid $segid and resid $resid and name N1)
                        (segid $psegid and resid $rpair and name O4)
                        geometry
                    evaluate ($n1o4=$result)
                    pick bond
                        (segid $segid and resid $resid and name N1)
                        (segid $psegid and resid $rpair and name O2)
                        geometry
                    evaluate ($n1o2=$result)
                    noe
                        assign (segid $segid and resid $resid and name N6)
                               (segid $psegid and resid $rpair and name O4)
                               $n6o4 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name N1)
                               (segid $psegid and resid $rpair and name N3)
                               $n1n3 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name N1)
                               (segid $psegid and resid $rpair and name O4)
                               $n1o4 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name N1)
                               (segid $psegid and resid $rpair and name O2)
                               $n1o2 $wc_low $wc_up
                    end
                end if
              else
                if ($dna_cg=true) then
                    ! C N3...G N1 maps onto SC2...SC3, C N4...G O6 onto SC3...SC3
                    ! and C O2...G N2 onto SC2...SC2. The N3...O6 and N3...N2
                    ! pairs of the all-atom code collapse onto those same bead
                    ! pairs and are therefore dropped.
                    pick bond
                        (segid $segid and resid $resid and name SC2)
                        (segid $psegid and resid $rpair and name SC3)
                        geometry
                    evaluate ($sc2sc3=$result)
                    pick bond
                        (segid $segid and resid $resid and name SC3)
                        (segid $psegid and resid $rpair and name SC3)
                        geometry
                    evaluate ($sc3sc3=$result)
                    pick bond
                        (segid $segid and resid $resid and name SC2)
                        (segid $psegid and resid $rpair and name SC2)
                        geometry
                    evaluate ($sc2sc2=$result)
                    noe
                        assign (segid $segid and resid $resid and name SC2)
                               (segid $psegid and resid $rpair and name SC3) $sc2sc3 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name SC3)
                               (segid $psegid and resid $rpair and name SC3) $sc3sc3 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name SC2)
                               (segid $psegid and resid $rpair and name SC2) $sc2sc2 $wc_low $wc_up
                    end
                else
                    pick bond
                        (segid $segid and resid $resid and name N3)
                        (segid $psegid and resid $rpair and name N1)
                        geometry
                    evaluate ($n3n1=$result)
                    pick bond
                        (segid $segid and resid $resid and name N4)
                        (segid $psegid and resid $rpair and name O6)
                        geometry
                    evaluate ($n4o6=$result)
                    pick bond
                        (segid $segid and resid $resid and name O2)
                        (segid $psegid and resid $rpair and name N2)
                        geometry
                    evaluate ($o2n2=$result)
                    pick bond
                        (segid $segid and resid $resid and name N3)
                        (segid $psegid and resid $rpair and name O6)
                        geometry
                    evaluate ($n3o6=$result)
                    pick bond
                        (segid $segid and resid $resid and name N3)
                        (segid $psegid and resid $rpair and name N2)
                        geometry
                    evaluate ($n3n2=$result)
                    noe
                        assign (segid $segid and resid $resid and name N3)
                               (segid $psegid and resid $rpair and name N1) $n3n1 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name N4)
                               (segid $psegid and resid $rpair and name O6) $n4o6 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name O2)
                               (segid $psegid and resid $rpair and name N2) $o2n2 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name N3)
                               (segid $psegid and resid $rpair and name O6) $n3o6 $wc_low $wc_up
                        assign (segid $segid and resid $resid and name N3)
                               (segid $psegid and resid $rpair and name N2) $n3n2 $wc_low $wc_up
                    end
                end if
              end if
            end if
        end loop resid
    end if
end if
